# Overrides for run_all.sh. Nothing here has to be edited. No secrets belong in this file.

# Where models and the build go. Empty = the writable filesystem with the most free space.
DATA_DIR=

# Container runtime: docker, podman or apptainer. Empty = first one found.
RUNTIME=

# --- Strata (real upstream is Niko1221/Strata; ro99/strata is an unrelated project) ---
STRATA_REPO=https://github.com/Niko1221/Strata.git
STRATA_COMMIT=d46f5f268f8ed797e83a5c63a69bffbd7a581cf6   # main on 2026-11-24, engine 0.1.67
STRATA_FAMILY=unsloth
STRATA_MODEL=UD-Q4_K_XL        # 111 GB download. With less disk the script switches both engines to IQ3_S (84 GB)
STRATA_CONTEXT=32768
STRATA_PORT=8080

# --- Ollama baseline (the running server; if none answers, the script starts one from the ollama binary) ---
OLLAMA_URL=http://127.0.0.1:11434
# Same model and quantization as Strata, for the fair comparison.
OLLAMA_MODEL=hf.co/unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL
# Optional: the ~100B model you run today, as a second reference row. Example: OLLAMA_CURRENT_MODEL=mymodel:tag
OLLAMA_CURRENT_MODEL=

# --- vLLM (optional) ---
# The vLLM recipe's Hopper setup is 8x H100/H200 with a 172.78 GiB FP8 checkpoint, so it does not fit one
# 96 GB GPU. If you have a vLLM endpoint anyway, set both and it is benchmarked with the same prompts.
VLLM_URL=
VLLM_MODEL=

# Rounds per prompt (medians are reported).
ROUNDS=3
