# Apptainer version of ./Dockerfile (same pinned image, same packages).
Bootstrap: docker
From: nvidia/cuda@sha256:1e8ac7a54c184a1af8ef2167f28fa98281892a835c981ebcddb1fad04bdd452d

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git libatomic1 libgomp1 libnuma1 python3 python3-pip python3-venv unzip
    rm -rf /var/lib/apt/lists/*
